#Parent Class

class Patient:
    def __init__(self, name, bill_amount):
        self.name = name
        self.bill_amount = bill_amount

    def get_name(self):
        return self.name

    def set_name(self, name):
        self.name = name

    def get_bill_amount(self):
        return self.bill_amount

    def set_bill_amount(self, bill_amount):
        self.bill_amount = float(bill_amount)
        
    def calculate_bill(self):
        return self.bill_amount
        
    def display_patient_type(self) :
        return "Regular Patient"
    
#Child Classes

class Senior_Patient(Patient):
    def calculate_bill(self):
        return self.get_bill_amount() * 0.80
        
    def display_patient_type(self) :
        return "Senior Patient"    
    
class PhilHealth_Patient(Patient):
    def calculate_bill(self):
        return self.get_bill_amount() * 0.85
        
    def display_patient_type(self) :
        return "PhilHealth Patient"
    
#Creating Objects
regular_patient = Patient("Juan Dela Cruz", 15000)
senior_patient = Senior_Patient("Maria Santos", 15000)
philhealth_patient = PhilHealth_Patient("Pedro Reyes", 15000)

